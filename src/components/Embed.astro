---
import Icon from './Icon.astro';
interface Props { src: string; title: string; provider: string; height: number; class?: string; image?: string }
const { src, title, provider, height, class: cls = '', image } = Astro.props;
---
<div class={`embed facade ${cls}`} style={`--h:${height}px`} data-embed-src={src} data-embed-title={title}>
  <button type="button" class="facade-btn">
    {image && <img class="facade-cover" src={image} alt="" width="480" height="360" loading="lazy" />}
    <span class="facade-action"><Icon name={provider} /> Reproducir en {provider}</span>
  </button>
  <a class="facade-note" href="/legal/cookies">Cookies del reproductor</a>
</div>
