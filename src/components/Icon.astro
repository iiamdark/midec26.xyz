---
interface Props { name: string }
const { name } = Astro.props;
---
<svg class="site-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  {name === 'Spotify' && <><circle cx="12" cy="12" r="11" fill="currentColor" /><path d="M6 9c4.2-1.2 8.5-.8 12 1.4M7 12.5c3.5-.9 7-.6 10 1.3m-9 1.8c2.8-.6 5.3-.3 7.7 1" fill="none" stroke="var(--icon-cutout, #0d0b10)" stroke-width="1.55" stroke-linecap="round" /></>}
  {name === 'Apple Music' && <path fill="currentColor" d="M20 3.5a1 1 0 0 0-1.2-1L9 4.7a1 1 0 0 0-.8 1V16c-.6-.2-1.3-.2-2 0-1.8.4-3.1 1.9-2.8 3.2.3 1.4 2 2.2 3.8 1.8 1.6-.4 2.8-1.5 2.8-2.7V8.4l8-1.8v7.3c-.6-.2-1.3-.2-2 0-1.8.4-3 1.9-2.8 3.2.3 1.4 2 2.2 3.8 1.8 1.8-.4 3-1.6 3-2.9Z" />}
  {name === 'YouTube' && <><rect x="2" y="5" width="20" height="14" rx="4" fill="currentColor" /><path d="m10 8.5 6 3.5-6 3.5z" fill="var(--icon-cutout, #0d0b10)" /></>}
  {name === 'Instagram' && <g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17" cy="7" r=".8" fill="currentColor" stroke="none" /></g>}
  {name === 'play' && <path d="M8 4.5v15l12-7.5z" fill="currentColor" />}
  {name === 'external' && <path d="M7 17 17 7M7 7h10v10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
</svg>
