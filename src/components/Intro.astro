---
// Loader + intro, built around Markho's pixel sunglasses (from his profile
// picture). Liquid red fills the mask while the page loads, the mask floods
// the screen, the glasses drop in, glint, and the left lens zooms in to reveal
// the site.
const u = 2;               // pixel size in viewBox units
const X0 = 20, Y0 = 38;    // glasses origin
const cols = 30;
// row -> [from, to] column ranges for each lens (row 0 is the solid bar)
const lensRows: [number, number][][] = [
  [[1, 12], [17, 28]],
  [[1, 12], [17, 28]],
  [[2, 12], [17, 27]],
  [[3, 11], [18, 26]],
];
const cell = (c: number, r: number) => `M${X0 + c * u} ${Y0 + r * u}h${u}v${u}h-${u}Z`;
const run = (r: number, a: number, b: number) => `M${X0 + a * u} ${Y0 + r * u}h${(b - a + 1) * u}v${u}h-${(b - a + 1) * u}Z`;
const bar = run(0, 0, cols - 1);
const lens = lensRows.map((ranges, i) => ranges.map(([a, b]) => run(i + 1, a, b)).join('')).join('');
// diagonal glints, like the "deal with it" glasses
const glint = [[3, 1], [4, 2], [5, 3], [19, 1], [20, 2], [21, 3]].map(([c, r]) => cell(c, r)).join('');
const HEAD = 'M50 12 C71 12 81 29 80 48 C79 67 67 84 50 86 C33 84 21 67 20 48 C19 29 29 12 50 12 Z';
---
<div class="intro" aria-hidden="true" transition:persist>
  <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" shape-rendering="crispEdges">
    <defs>
      <mask id="intro-mask" maskUnits="userSpaceOnUse" x="-500" y="-500" width="1100" height="1100">
        <rect x="-500" y="-500" width="1100" height="1100" fill="#fff" />
        <path class="lens-hole" d={lens} fill="#000" opacity="0" />
      </mask>
      <clipPath id="head-clip"><path class="head-shape" d={HEAD} /></clipPath>
    </defs>
    <g mask="url(#intro-mask)">
      <rect x="-500" y="-500" width="1100" height="1100" fill="#ffe600" />
      <g clip-path="url(#head-clip)">
        <path class="head-fill" fill="#ef3b2c" d="M-500 86 L600 86 L600 600 L-500 600 Z" />
        <path class="head-shade" fill="#d12f22" d="M50 86 C67 84 79 67 80 48 C79 67 64 78 50 80 Z" shape-rendering="geometricPrecision" />
      </g>
      <path class="head-line" d={HEAD} fill="none" stroke="#333" stroke-width="1.2" stroke-linejoin="round" shape-rendering="geometricPrecision" />
      <text class="intro-name" x="50" y="96" text-anchor="middle" font-size="7" fill="#333" shape-rendering="geometricPrecision">MARKHO</text>
      <g class="glasses">
        <path d={bar} fill="#1c1c1c" />
        <path class="lens" d={lens} fill="#1c1c1c" />
        <path class="glint" d={glint} fill="#fff" />
      </g>
    </g>
  </svg>
  <button class="skip cap" type="button">Saltar intro →</button>
</div>
