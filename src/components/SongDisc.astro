---
import { cover, fmtDate, type Song } from '../data';
interface Props { song: Song; index?: number }
const { song, index } = Astro.props;
---
<button type="button" class={`disc pop ${song.color}`} data-play={`spotify:${song.spotify}`} data-title={song.t} aria-label={`Escuchar ${song.t} en Spotify`}>
  <img src={cover(song)} alt="" loading="lazy" width="640" height="640" />
  <span class="disc-play" aria-hidden="true">▶</span>
  <span class="disc-label">
    {index !== undefined && <span class="cap">{String(index + 1).padStart(2, '0')}</span>}
    <span class="h3">{song.t}</span>
    <span class="cap">{fmtDate(song.date)} · {song.dur}{song.explicit && ' · E'}</span>
  </span>
</button>
