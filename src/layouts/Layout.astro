---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/changa-one';
import '../styles/global.css';
import Intro from '../components/Intro.astro';
import { artist, formerly, nav, socials, email, songs, spotify, youtube, instagram, trackUrl, site } from '../data';

interface Props { title?: string; description?: string; image?: string }
const {
  title,
  description = `${artist} (antes ${formerly}), artista emergente español de género urbano. Escucha sus singles en Spotify y mira sus vídeos.`,
  image = '/img/markho.jpg',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = title ? `${title} — ${artist}` : `${artist} — Sitio oficial`;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Markho',
  alternateName: formerly,
  genre: 'Urbano',
  url: site,
  image: new URL('/img/markho.jpg', site).href,
  email,
  sameAs: [spotify, youtube, instagram],
  track: songs.map((s) => ({ '@type': 'MusicRecording', name: s.t, url: trackUrl(s), datePublished: s.date })),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={artist} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#ffe600" />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.add('intro-on');
    </script>
    <ClientRouter />
  </head>
  <body>
    <Intro />
    <nav class="top" transition:persist>
      <ul>
        {nav.map((n) => <li><a href={n.href} aria-current={(n.href === '/' ? path === '/' : path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>

    <main><slot /></main>

    <footer class="pad">
      <div class="giant" aria-hidden="true">{artist}</div>
      <div class="row">
        <span>© 2026 {artist} · antes {formerly}</span>
        <ul>{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>)}</ul>
        <a href={`mailto:${email}`}>{email}</a>
      </div>
    </footer>

    <dialog class="player" transition:persist aria-label="Reproductor">
      <div class="player-bar">
        <span class="sub player-title"></span>
        <button type="button" class="player-close" aria-label="Cerrar">✕</button>
      </div>
      <div class="player-frame"></div>
    </dialog>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
