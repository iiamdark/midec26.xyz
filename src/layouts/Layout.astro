---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { ads, adsEnabled, legalLinks } from '../legal';
import { artist, formerly, nav, socials, email, songs, spotify, youtube, instagram, trackUrl, site, appleMusic, label } from '../data';

interface Props { title?: string; description?: string; image?: string }
const {
  title,
  description = `${artist} (antes ${formerly}), artista emergente español de género urbano. Escucha sus singles en Spotify y mira sus vídeos.`,
  image = '/img/markho.jpg',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = title ? `${title} — ${artist}` : `${artist} — Sitio oficial`;
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'Markho',
  alternateName: formerly,
  genre: 'Urbano',
  url: site,
  image: new URL('/img/markho.jpg', site).href,
  email,
  sameAs: [spotify, appleMusic, youtube, instagram],
  recordLabel: label,
  track: songs.map((s) => ({ '@type': 'MusicRecording', name: s.t, url: trackUrl(s), datePublished: s.date })),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={artist} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#11120f" />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      try { if (localStorage.getItem('mk-theme-v2') === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}
    </script>
    {adsEnabled() && (
      <script is:inline async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.adsenseClient}`}></script>
    )}
    {adsEnabled() && <meta name="google-adsense-account" content={ads.adsenseClient} />}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <div class="scroll-progress" aria-hidden="true" transition:persist></div>
    <nav class="top" aria-label="Navegación principal" transition:persist>
      <a class="brand" href="/" aria-label="Markho, inicio">MK<span>↗</span></a>
      <ul>
        {nav.map((n, i) => <li><a href={n.href} aria-current={(n.href === '/' ? path === '/' : path.startsWith(n.href)) ? 'page' : undefined}><span class="nav-index" aria-hidden="true">0{i + 1}</span>{n.label}</a></li>)}
      </ul>
      <button type="button" class="theme-toggle" aria-label="Activar tema claro" aria-pressed="false" title="Cambiar tema"><span aria-hidden="true">◐</span></button>
    </nav>

    <main id="main"><slot /></main>

    <footer class="pad">
      <div class="footer-heading"><p class="eyebrow">El siguiente capítulo empieza contigo.</p><a class="footer-cta" href={`mailto:${email}`}>Hablemos <span>↗</span></a></div>
      <div class="row"><span class="cap">© 2026 {artist} / antes {formerly}</span><ul>{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>)}</ul><a href={`mailto:${email}`}>{email}</a></div>
      <div class="footer-word" aria-hidden="true">{artist}<span>↗</span></div>
      <nav class="row legal-links" aria-label="Textos legales">
        {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        <button type="button" data-consent-open>Configurar cookies</button><span class="footer-status"><i class="status-dot"></i> Siempre en movimiento</span>
      </nav>
    </footer>

    <dialog class="player" transition:persist aria-label="Reproductor">
      <div class="player-bar">
        <span class="sub player-title"></span>
        <button type="button" class="player-close" aria-label="Cerrar">✕</button>
      </div>
      <div class="player-frame"></div>
    </dialog>

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
