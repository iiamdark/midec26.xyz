---
import Layout from '../layouts/Layout.astro';
import Cloud from '../components/Cloud.astro';
import { shows } from '../data';
---
<Layout title="Gira">
  <section class="pad page-head scene" style="min-height:auto">
    <Cloud style="top:18%;right:10%" speed={1.1} />
    <h1 class="h1 split">Gira 2026—27</h1>
    <p class="reveal">Fechas confirmadas. Más ciudades pronto.</p>
  </section>
  <section class="pad" style="padding-bottom:10vh">
    <ul class="shows">
      {shows.map((s) => (
        <li class="reveal">
          <span class="when">{s.d}<br /><span class="cap">{s.y}</span></span>
          <div><span class="city">{s.c}</span><span class="venue">{s.v}{s.s === 'Últimas' && ' · Últimas entradas'}</span></div>
          {s.s === 'Agotado'
            ? <span class="stamp out">Agotado</span>
            : <a class="stamp" href="#">Entradas</a>}
        </li>
      ))}
    </ul>
  </section>
</Layout>
