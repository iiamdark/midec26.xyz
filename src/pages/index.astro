---
import Layout from '../layouts/Layout.astro';
import { artist, formerly, songs, cover, fmtDate, spotify, playSource, videos, thumb } from '../data';
const releases = songs.slice(0, 4);
const latest = songs[0];
---
<Layout description="El mañana suena hoy. Música, visualizers y el universo de MARKHO. Descubre Mañana y escucha sus últimos lanzamientos.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-art" aria-hidden="true">
      <div class="orb-fallback"></div>
      <canvas data-sculpture></canvas>
      <span class="art-coordinate cap">MK / FRECUENCIA 026</span>
    </div>
    <div class="hero-topline cap"><span><i class="status-dot"></i> Artista independiente · España</span><span>Nuevo capítulo / 2026</span></div>
    <div class="hero-copy">
      <p class="eyebrow hero-enter">El mañana suena hoy.</p>
      <p class="hero-statement hero-enter">Siempre<br />hacia <em>arriba.</em></p>
      <a href="#manana" class="text-link hero-enter">Descubre Mañana <span aria-hidden="true">↗</span></a>
    </div>
    <button class="hero-release hero-enter" type="button" data-play={playSource(latest)} data-title={latest.t} aria-label={`Escuchar ${latest.t} en YouTube`}>
      <img src={cover(latest)} alt="" width="120" height="90" />
      <span><span class="cap">Sonando ahora</span><strong>{latest.t}</strong></span>
      <span class="round-arrow" aria-hidden="true">▶</span>
    </button>
    <h1 id="hero-title" class="hero-word" aria-label={artist}>{artist}<span class="word-star" aria-hidden="true">✳</span></h1>
    <div class="hero-bottom cap"><a href="#manana">Scroll para entrar ↓</a><span>Música / Visuales / Sin pausa</span><span>Antes {formerly}</span></div>
  </section>

  <section id="manana" class="release-section" aria-labelledby="release-title">
    <div class="section-heading pad">
      <div><p class="eyebrow"><span class="section-index">01 /</span> El nuevo capítulo</p><h2 id="release-title" class="h1 split">Mañana<span class="accent">.</span></h2></div>
      <p class="section-note">Cuatro temas.<br />Una dirección: hacia delante.</p>
      <span class="rail-hint cap" aria-hidden="true">Desliza para explorar ↔</span>
    </div>
    <div class="release-window" tabindex="0" aria-label="Los cuatro temas de Mañana; desplaza para explorar">
      <div class="release-rail">
        {releases.map((s, i) => (
          <article class="release-card">
            <div class="release-card-top cap"><span>MK / {String(i + 1).padStart(2, '0')}</span><span>{s.dur} — 2026</span></div>
            <button type="button" class="release-art" data-play={playSource(s)} data-title={s.t} aria-label={`Reproducir ${s.t}`}>
              <img src={cover(s)} alt={`Visual de ${s.t}`} width="640" height="480" loading="lazy" />
              <span class="release-art-word" aria-hidden="true">MAÑANA</span>
              <span class="release-play" aria-hidden="true">↗</span>
              <span class="cap release-art-tag">Markho / Visualizer</span>
            </button>
            <div class="release-caption"><h3><a href={`/musica/${s.slug}`}>{s.t}</a></h3><a href={`/musica/${s.slug}`} class="circle-link" aria-label={`Ver ${s.t}`}>↗</a></div>
          </article>
        ))}
      </div>
    </div>
    <div class="release-bottom pad cap"><span>Disponible en YouTube</span><a href="/videos">Ver todos los visuales ↗</a><span>13.11.2026</span></div>
  </section>

  <div class="ticker" aria-hidden="true"><div class="ticker-track">{[0, 1, 2, 3].map(() => <span>DE ABAJO HACIA ARRIBA <b>↗</b> SIN MIRAR ATRÁS <b>✳</b></span>)}</div></div>

  <section class="artist-section pad" aria-labelledby="artist-title">
    <div class="artist-image"><img data-parallax src="/img/markho.jpg" alt="Retrato de Markho" width="900" height="900" loading="lazy" /><span class="image-label cap">MARKHO / EN PRIMERA PERSONA</span><span class="image-cross" aria-hidden="true">+</span></div>
    <div class="artist-copy"><p class="eyebrow reveal"><span class="section-index">02 /</span> Detrás del nombre</p><h2 id="artist-title" class="h1 split">Mismo pulso.<br />Nueva<br /><em>frecuencia.</em></h2><p class="body-copy reveal">Antes {formerly}. Ahora MARKHO. Música urbana, historias propias y una forma de mirar hacia lo que viene. Cada canción, una nueva pieza del proyecto.</p><a href="/sobre" class="text-link reveal">Conoce a Markho <span>↗</span></a></div>
  </section>

  <section class="catalog-section pad" aria-labelledby="catalog-title">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-index">03 /</span> El archivo</p><h2 id="catalog-title" class="h1 split">Dale al play<span class="accent">.</span></h2></div><a href="/musica" class="text-link">Toda la música <span>↗</span></a></div>
    <ol class="catalog-list">
      {songs.slice(4).map((s, i) => (
        <li class="catalog-row">
          <span class="cap catalog-number">{String(i + 1).padStart(2, '0')}</span>
          <img src={cover(s)} alt="" width="80" height="80" loading="lazy" />
          <a class="catalog-title" href={`/musica/${s.slug}`}>{s.t}</a>
          <span class="cap catalog-date">{fmtDate(s.date)}</span>
          <span class="cap catalog-duration">{s.dur}</span>
          <button class="catalog-play" type="button" data-play={playSource(s)} data-title={s.t} aria-label={`Escuchar ${s.t}`}>↗</button>
        </li>
      ))}
    </ol>
    <a href={spotify} target="_blank" rel="noopener" class="text-link catalog-follow">Seguir en Spotify <span>↗</span></a>
  </section>

  <section class="home-visual pad" aria-labelledby="visual-title">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-index">04 /</span> En movimiento</p><h2 id="visual-title" class="h1 split">Dale al <em>rec.</em></h2></div><a href="/videos" class="text-link">Todos los vídeos <span>↗</span></a></div>
    <button type="button" class="cinema-frame" data-play="youtube:okZgYt5MAJ4" data-title="Entre Sombras y Luces" aria-label="Ver Entre Sombras y Luces">
      <img data-parallax src={thumb('okZgYt5MAJ4')} alt="Markho en el videoclip Entre Sombras y Luces" width="1280" height="720" loading="lazy" />
      <span class="cinema-top cap"><span>Videoclip oficial</span><span>MARKHO / 2025</span></span><span class="cinema-play" aria-hidden="true">▶</span><span class="cinema-title">Entre sombras<br />y luces<span>↗</span></span>
    </button>
  </section>
</Layout>
