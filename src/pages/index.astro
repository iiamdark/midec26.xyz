---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { artist, songs, spotify, thumb } from '../data';

const releases = songs.filter(song => song.project === 'Mañana');
const lead = releases[0];
---
<Layout description="MARKHO. Escucha Mañana y descubre su música y sus videoclips.">
  <div class="hero-journey" data-journey>
    <section class="planet-hero" aria-labelledby="hero-title">
      <div class="planet-sky" aria-hidden="true">
        <span class="orbit-line"></span>
      </div>
      <div class="planet-world" aria-hidden="true"><canvas data-sculpture></canvas></div>
      <div class="planet-copy">
        <p>El mañana suena hoy</p>
        <h1 id="hero-title">{artist}</h1>
        <a class="planet-button" href="#manana">Explorar Mañana <span aria-hidden="true">↓</span></a>
      </div>
      <a class="planet-play" href={`/musica/${lead.slug}`}>
        <Icon name="play" /> <span><small>Último lanzamiento</small>Escuchar {lead.t}</span>
      </a>
      <div class="journey-mask" aria-hidden="true"><span>Mañana</span></div>
    </section>
  </div>

  <section id="manana" class="record-scene pad" aria-labelledby="release-title">
    <header>
      <p>Último proyecto</p>
      <h2 id="release-title" class="split">Mañana</h2>
    </header>
    <ol class="record-list">
      {releases.map((song, index) => (
        <li class="record-row">
          <span class="record-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <a href={`/musica/${song.slug}`}>{song.t}</a>
          <span class="record-duration">{song.dur}</span>
          <a class="song-open" href={`/musica/${song.slug}`} aria-label={`Abrir ${song.t}`}><Icon name="play" /></a>
        </li>
      ))}
    </ol>
    <a class="planet-button" href="/musica">Toda la música <span aria-hidden="true">↗</span></a>
  </section>

  <section class="portrait-scene pad" aria-labelledby="artist-title">
    <div class="portrait-orbit">
      <img data-parallax src="/img/markho.jpg" alt="Retrato de Markho" width="900" height="900" loading="lazy" />
    </div>
    <div>
      <h2 id="artist-title" class="split">Quién es<br />Markho</h2>
      <p>Música urbana e historias propias desde España.</p>
      <a class="planet-button" href="/sobre">Sobre Markho <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="film-scene pad" aria-labelledby="visual-title">
    <div>
      <p>Videoclip oficial</p>
      <h2 id="visual-title" class="split">Entre sombras<br />y luces</h2>
      <a class="planet-button" href="/videos">Todos los vídeos <span aria-hidden="true">↗</span></a>
    </div>
    <a href="/musica/entre-sombras-y-luces#escuchar" class="film-play" aria-label="Abrir Entre Sombras y Luces">
      <img src={thumb('okZgYt5MAJ4')} alt="" width="1280" height="720" loading="lazy" />
      <span aria-hidden="true">▶</span>
    </a>
  </section>
  <section class="listen-scene pad">
    <h2 class="split">Sigue a Markho</h2>
    <a class="planet-button" href={spotify} target="_blank" rel="noopener"><Icon name="Spotify" /> Abrir Spotify</a>
  </section>
</Layout>
