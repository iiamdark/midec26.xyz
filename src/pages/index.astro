---
import Layout from '../layouts/Layout.astro';
import Cloud from '../components/Cloud.astro';
import { artist, formerly, releases } from '../data';
---
<Layout>
  <section class="scene hero">
    <Cloud style="top:18%;left:6%" speed={0.6} />
    <Cloud style="top:32%;right:8%;width:clamp(160px,22vw,320px)" speed={1.2} />
    <Cloud style="top:62%;left:22%;width:clamp(90px,12vw,170px)" speed={0.9} />
    <div class="tag">
      <span class="badge cap hero-in">Nuevo álbum · Nocturno</span>
    </div>
    <div class="globe" data-globe></div>
    <svg class="globe-text" viewBox="0 0 1000 500" aria-label={artist}>
      <path id="arc" d="M60 470 A520 520 0 0 1 940 470" fill="none" />
      <text font-size="190" text-anchor="middle"><textPath href="#arc" startOffset="50%" class="arc-text">{artist}</textPath></text>
    </svg>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => ['Nocturno', 'Gira 2026', artist, 'Nuevo álbum', 'En vivo'].map((w) => <span>{w}</span>))}
    </div>
  </div>

  <section class="pad intro-block">
    <h2 class="h1">
      <span class="split">Antes</span> <span class="strike" data-strike>{formerly}.</span><br />
      <span class="split">Ahora {artist}.</span>
    </h2>
    <p class="sub reveal" style="max-width:520px;margin-top:45px">Mismo pulso, nuevo nombre. Un capítulo nuevo empieza con <em>Nocturno</em>, el primer álbum como {artist}.</p>
  </section>

  <section class="pad">
    <h2 class="h2 split" style="margin-bottom:45px">Lo último</h2>
    <div class="discs">
      {releases.slice(0, 3).map((r) => (
        <a class={`disc pop ${r.color}`} href="/musica">
          <span class="h2">{r.t}</span>
          <span class="cap">{r.k} · {r.y}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="pad">
    <div class="next">
      <a href="/gira" class="pop">Gira →</a>
      <a href="/sobre" class="pop">Sobre →</a>
      <a href="/contacto" class="pop">Contacto →</a>
    </div>
  </section>
</Layout>
