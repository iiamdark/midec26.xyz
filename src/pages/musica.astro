---
import Layout from '../layouts/Layout.astro';
import Cloud from '../components/Cloud.astro';
import SongDisc from '../components/SongDisc.astro';
import { songs, youtube } from '../data';
---
<Layout title="Música">
  <section class="pad page-head scene" style="min-height:auto">
    <Cloud style="top:22%;right:6%" speed={0.8} />
    <h1 class="h1 split">Música</h1>
    <p class="reveal">Todas las canciones de Markho. Toca un disco para escucharlo aquí mismo.</p>
  </section>
  <section class="pad">
    <div class="discs">
      {songs.map((s, i) => <SongDisc song={s} index={i} />)}
    </div>
    <ol class="tracklist reveal">
      {songs.map((s, i) => (
        <li>
          <button type="button" data-play={s.id} data-title={s.t}>
            <span class="cap">{String(i + 1).padStart(2, '0')}</span>
            <span class="t">{s.t}</span>
            <span class="cap">{s.k}</span>
            <span class="cap">{s.dur}</span>
          </button>
        </li>
      ))}
    </ol>
    <p style="padding:45px 0 10vh"><a class="btn" href={youtube} target="_blank" rel="noopener">Ver canal en YouTube ↗</a></p>
  </section>
</Layout>
