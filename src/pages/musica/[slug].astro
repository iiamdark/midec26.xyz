---
import Layout from '../../layouts/Layout.astro';
import { songs, cover, fmtDate, trackUrl, thumb, artist, type Song } from '../../data';

export function getStaticPaths() {
  return songs.map((song, i) => ({ params: { slug: song.slug }, props: { song, i } }));
}
interface Props { song: Song; i: number }
const { song, i } = Astro.props;
const prev = songs[i - 1], next = songs[i + 1];
---
<Layout title={song.t} description={`«${song.t}» de ${artist}. Single publicado el ${fmtDate(song.date)}.`} image={cover(song)}>
  <section class="pad song-hero">
    <img class={`song-cover pop ${song.color}`} src={cover(song)} alt={`Portada de ${song.t}`} width="640" height="640" />
    <div>
      <a href="/musica" class="cap back">← Música</a>
      <h1 class="h1 split">{song.t}</h1>
      <p class="sub reveal" style="margin-top:20px">Single · {fmtDate(song.date)} · {song.dur}{song.explicit && ' · Explícito'}</p>
      <div class="actions reveal">
        <button type="button" class="btn" data-play={`spotify:${song.spotify}`} data-title={song.t}>▶ Escuchar</button>
        <a class="btn ghost" href={trackUrl(song)} target="_blank" rel="noopener">Abrir en Spotify ↗</a>
      </div>
    </div>
  </section>

  <section class="pad embed-block">
    <div class="embed small reveal">
      <iframe src={`https://open.spotify.com/embed/track/${song.spotify}?theme=0`} title={`${song.t} en Spotify`} loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
    </div>
  </section>

  {song.youtube && (
    <section class="pad" style="padding-bottom:10vh">
      <h2 class="h2 split" style="margin-bottom:45px">Visual</h2>
      <button type="button" class="video-media reveal" data-play={`youtube:${song.youtube}`} data-title={song.t} aria-label={`Ver el vídeo de ${song.t}`}>
        <img src={thumb(song.youtube)} alt="" width="1280" height="720" loading="lazy" />
        <span class="disc-play" aria-hidden="true">▶</span>
      </button>
    </section>
  )}

  <nav class="pad prevnext" aria-label="Otros singles">
    {prev ? <a href={`/musica/${prev.slug}`} class="pop"><span class="cap">← Más nuevo</span><span class="h3">{prev.t}</span></a> : <span></span>}
    {next ? <a href={`/musica/${next.slug}`} class="pop"><span class="cap">Anterior →</span><span class="h3">{next.t}</span></a> : <span></span>}
  </nav>
</Layout>
