---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Collabs from '../../components/Collabs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { songs, cover, spotify } from '../../data';

const groups = [
  { id: 'manana', label: 'Mañana', tracks: songs.filter(song => song.project === 'Mañana') },
  { id: 'singles', label: 'Singles', tracks: songs.filter(song => !song.project) },
  { id: 'covers', label: 'Covers', tracks: songs.filter(song => song.project === 'Cover') },
];
---
<Layout title="Música" description="Discografía de MARKHO. Escucha Mañana y sus singles.">
  <header class="archive-head pad">
    <p class="eyebrow">Discografía</p>
    <h1 class="split">Música<span>.</span></h1>
    <nav class="archive-links" aria-label="Ir a la colección">
      {groups.map(group => <a href={`#${group.id}`}>{group.label} ↓</a>)}
      <a href={spotify} target="_blank" rel="noopener"><Icon name="Spotify" /> Spotify</a>
    </nav>
  </header>

  {groups.map(group => (
    <section class="collection pad" id={group.id} aria-labelledby={`${group.id}-title`}>
      <div class="collection-head">
        <h2 id={`${group.id}-title`}>{group.label}</h2>
        <span class="cap">{group.tracks.length} temas</span>
      </div>
      <ul class="track-shelf">
        {group.tracks.map(song => (
          <li class="track-tile">
            <div class="track-sleeve">
              <a href={`/musica/${song.slug}`} tabindex="-1" aria-hidden="true">
                <img src={cover(song)} alt="" width="640" height="640" loading="lazy" />
              </a>
              <a class="song-open" href={`/musica/${song.slug}`} aria-label={`Abrir ${song.t}`}><Icon name="play" /></a>
            </div>
            <div class="track-caption">
              <h3><a href={`/musica/${song.slug}`}>{song.t}</a></h3>
              <span>{song.dur} {song.explicit && <abbr title="Explícito">E</abbr>}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <AdSlot slot="music" />
  <Collabs />
</Layout>
