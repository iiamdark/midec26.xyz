---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { artist, songs, spotify } from '../data';

const releases = songs.filter(song => song.project === 'Mañana');
---
<Layout title="Sobre mí" description="Conoce a MARKHO, artista urbano español.">
  <section class="bio-cover pad" aria-labelledby="bio-title">
    <div class="bio-copy">
      <p class="eyebrow">Sobre mí</p>
      <h1 id="bio-title" class="split">{artist}<span>.</span></h1>
      <p>Hago música urbana desde España y acompaño mis canciones con videoclips y visualizers.</p>
      <a class="planet-button" href="/musica">Escuchar mi música <Icon name="play" /></a>
    </div>
    <figure class="bio-photo">
      <img src="/img/markho.jpg" alt="Retrato de Markho" width="900" height="900" data-parallax />
    </figure>
  </section>
  <section class="bio-chapter pad" aria-labelledby="bio-music">
    <div>
      <p class="eyebrow">Último proyecto</p>
      <h2 id="bio-music" class="split">Mañana</h2>
      <p>Cuatro canciones, cada una con su propio visualizer.</p>
    </div>
    <ol>
      {releases.map(song => <li><a href={`/musica/${song.slug}`}>{song.t}<Icon name="external" /></a></li>)}
    </ol>
  </section>
  <section class="bio-contact pad">
    <h2>¿Hacemos algo juntos?</h2>
    <div><a class="planet-button" href="/contacto">Contacto <Icon name="external" /></a><a class="planet-button" href={spotify} target="_blank" rel="noopener"><Icon name="Spotify" /> Spotify</a></div>
  </section>
</Layout>
