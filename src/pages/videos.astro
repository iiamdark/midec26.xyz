---
import Layout from '../layouts/Layout.astro';
import Cloud from '../components/Cloud.astro';
import Collabs from '../components/Collabs.astro';
import { videos, thumb, youtube } from '../data';
---
<Layout title="Vídeos" description="Videoclips y visualizers de Markho.">
  <section class="pad page-head scene" style="min-height:auto">
    <Cloud style="top:18%;right:10%" speed={1.1} />
    <h1 class="h1 split">Vídeos</h1>
    <p class="reveal">Videoclips y visualizers del canal de YouTube.</p>
  </section>
  <section class="pad videos">
    {videos.map((v, i) => (
      <article class="video reveal">
        <button type="button" class="video-media" data-play={`youtube:${v.id}`} data-title={v.t} aria-label={`Reproducir ${v.t}`}>
          <img src={thumb(v.id)} alt="" width="1280" height="720" loading={i ? 'lazy' : 'eager'} />
          <span class="disc-play" aria-hidden="true">▶</span>
        </button>
        <div class="video-info">
          <span class="cap">{v.k} · {v.y} · {v.dur}</span>
          <h2 class="h2">{v.t}</h2>
        </div>
      </article>
    ))}
  </section>
  <Collabs />
  <section class="pad">
    <p style="padding:20px 0 10vh"><a class="btn" href={youtube} target="_blank" rel="noopener">Suscríbete en YouTube ↗</a></p>
  </section>
</Layout>
